Unit : * = ((A:*) A => A)
unit : Unit = (A (a:A) -> a)

Bool : * = ((A:*) A A => A)
false : Bool = ( A (0:A) (_:A) -> 0)
true  : Bool = ( A (_:A) (1:A) -> 1)
not : (Bool      => Bool) = ((a:Bool)          -> a Bool true false)
and : (Bool Bool => Bool) = ((a:Bool) (b:Bool) -> a Bool false b)
or  : (Bool Bool => Bool) = ((a:Bool) (b:Bool) -> a Bool b true)


expr : Bool = (and true (or false true))
