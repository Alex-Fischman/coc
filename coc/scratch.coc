Unit : *    = ((T : *)      T  => T)
unit : Unit = ((T : *) (x : T) -> x)

Bool  : *    = ((A : *)      A       A  => A)
false : Bool = ((A : *) (0 : A) (_ : A) -> 0)
true  : Bool = ((A : *) (_ : A) (1 : A) -> 1)

and
: (Bool Bool => Bool)
= ((a : Bool) (b : Bool) -> a Bool false (b Bool false true))
